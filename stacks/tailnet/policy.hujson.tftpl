// Tailnet policy. Rendered by acl.tf; addresses come from ansible/group_vars/all.yml
{
	"hosts": {
		"lan":    "${lan}",
		"pihole": "${pihole}",
		"caddy":  "${caddy}",
		// One per Proxmox node, named after it
%{ for node, ip in nodes ~}
		"${node}": "${ip}",
%{ endfor ~}
	},

	"tagOwners": {
		"tag:homelab": ["autogroup:admin"],
	},

	// Nothing grants tag:homelab as a source, so the Proxmox nodes can't open connections to your devices
	"grants": [
		// Admins reach everything, including the whole LAN through the subnet router
		{"src": ["autogroup:admin"], "dst": ["*"], "ip": ["*"]},

		// Everyone else gets their own devices
		{"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},
		// ...and the *.home.arpa names: DNS from Pi-hole, then the web UIs through Caddy
		{"src": ["autogroup:member"], "dst": ["pihole"], "ip": ["tcp:53", "udp:53"]},
		{"src": ["autogroup:member"], "dst": ["caddy"], "ip": ["tcp:80"]},
	],

	// Tailscale SSH into your own devices, re-checking login periodically
	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	// Checked on every save; a failing test rejects the policy
	"tests": [
		{
			"src":  "tag:homelab",
			"deny": [%{ for node, ip in nodes }"${node}:8006", %{ endfor }"pihole:53", "caddy:80"],
		},
	],
}
