global_defs {
	enable_script_security
	script_user root
}

vrrp_script check_service {
	script "/usr/bin/systemctl is-active --quiet {{ keepalived_service }}"
	interval 2
	fall 2
	rise 2
}

vrrp_instance vip {
	# Both start as backup and the higher priority takes over
	state BACKUP
	interface eth0
	virtual_router_id {{ keepalived_router_id }}
	priority {{ 100 - 10 * keepalived_hosts.index(inventory_hostname) }}
	advert_int 1
	# Unicast so it doesn't depend on multicast making it across the bridge
	unicast_src_ip {{ guests[inventory_hostname].ip }}
	unicast_peer {
{% for host in keepalived_hosts if host != inventory_hostname %}
		{{ guests[host].ip }}
{% endfor %}
	}
	virtual_ipaddress {
		{{ keepalived_vip }}/24
	}
	track_script {
		check_service
	}
}
