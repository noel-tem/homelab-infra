{# http:// prefix keeps Caddy from trying to get certificates #}
{% for name, upstream in caddy_proxied_services | dictsort %}
{% if not loop.first %}

{% endif %}
http://{{ name }}.{{ caddy_domain }} {
{% if upstream is match('https://') %}
	# The upstream only serves HTTPS, with a self-signed certificate
	reverse_proxy {{ upstream }} {
		transport http {
			tls_insecure_skip_verify
		}
	}
{% else %}
	reverse_proxy {{ upstream }}
{% endif %}
}
{% endfor %}
