[agent]
  interval = "{{ disk_health_interval }}"
  flush_interval = "{{ disk_health_interval }}"

[[outputs.influxdb_v2]]
  urls = ["{{ influxdb_url }}"]
  token = "{{ influxdb_token }}"
  organization = "{{ influxdb_org }}"
  bucket = "{{ influxdb_bucket }}"

# SMART health, temperature and the attributes that predict failure
[[inputs.smart]]
  use_sudo = true
  attributes = true
  # Don't wake a disk that's spun down just to read it
  nocheck = "standby"
  timeout = "30s"

# Capacity of every mounted filesystem
[[inputs.disk]]
  ignore_fs = [{% for fs in disk_health_ignore_fs %}"{{ fs }}"{{ ", " if not loop.last }}{% endfor %}]

[[inputs.exec]]
  commands = ["/usr/local/bin/zpool-capacity"]
  data_format = "influx"
