apiVersion: 1
datasources:
  - name: InfluxDB
    uid: influxdb
    type: influxdb
    access: proxy
    url: http://localhost:8086
    isDefault: true
    jsonData:
      version: Flux
      organization: {{ influxdb_org }}
      defaultBucket: {{ influxdb_bucket }}
    secureJsonData:
      token: {{ influxdb_token }}
